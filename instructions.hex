// Phase 1: Basic Math & EX-to-EX Forwarding
00500093 // 00: addi x1, x0, 5      (x1 = 5)
00a00113 // 04: addi x2, x0, 10     (x2 = 10)
002081b3 // 08: add  x3, x1, x2     (x3 = 15)
40118233 // 0C: sub  x4, x3, x1     (x4 = 10 -> triggers EX-EX forwarding)

// Phase 2: MEM-to-EX Forwarding
002082b3 // 10: add  x5, x1, x2     (x5 = 15)
00000013 // 14: addi x0, x0, 0      (NOP to push the add into MEM)
40228333 // 18: sub  x6, x5, x2     (x6 = 5 -> triggers MEM-EX forwarding)

// Phase 3: The Load-Use Stall
00602023 // 1C: sw   x6, 0(x0)      (Store 5 to address 0)
00002383 // 20: lw   x7, 0(x0)      (Load 5 back into x7)
00138433 // 24: add  x8, x7, x1     (x8 = 10 -> triggers Load-Use Stall)

// Phase 4: Control Hazards & Flushing
00240663 // 28: beq  x8, x2, 12     (If 10==10, jump forward 12 bytes/3 instructions)
06300493 // 2C: addi x9, x0, 99     (BAD: In Decode stage, must be flushed)
06300493 // 30: addi x9, x0, 99     (BAD: In Fetch stage, must be flushed)

// Phase 5: Branch Not Taken & ALU Logic
00a51463 // 34: bne  x10, x10, 8    (If 0 != 0 jump. FALSE! Do not jump.)
0020f5b3 // 38: and  x11, x1, x2    (x11 = 5 & 10 = 0101 & 1010 = 0)
0020e633 // 3C: or   x12, x1, x2    (x12 = 5 | 10 = 0101 | 1010 = 15)

// Phase 6: Jump and Link (jal) & U-Type
00c006ef // 40: jal  x13, 12        (Jump forward 12 bytes. Save PC+4 (0x44) to x13)
06300713 // 44: addi x14, x0, 99    (BAD: In Decode. Must be flushed)
06300713 // 48: addi x14, x0, 99    (BAD: In Fetch. Must be flushed)

// Target of JAL
000047b7 // 4C: lui  x15, 4         (x15 = 4 << 12 = 16384. Execution lands here)

// Phase 7: SLT (Set Less Than) — R-type, funct3=010
00132833 // 50: slt  x16, x6, x1    (x6=5, x1=5 -> 5 < 5 = 0, x16 = 0)
001028b3 // 54: slt  x17, x0, x1    (x0=0, x1=5 -> 0 < 5 = 1, x17 = 1)

// Phase 8: SLTI (Set Less Than Immediate) — I-type, funct3=010
0030a913 // 58: slti x18, x1, 3     (x1=5, 5 < 3 = 0, x18 = 0)
00a0a993 // 5C: slti x19, x1, 10    (x1=5, 5 < 10 = 1, x19 = 1)

// Phase 9: ORI (OR Immediate) — I-type, funct3=110
00a0ea13 // 60: ori  x20, x1, 0xA   (x1=5=0101, 0xA=1010, 0101|1010=1111=15, x20 = 15)

// Phase 10: ANDI (AND Immediate) — I-type, funct3=111
0030fa93 // 64: andi x21, x1, 0x3   (x1=5=0101, 0x3=0011, 0101&0011=0001=1, x21 = 1)

// Phase 11: Negative Numbers & Signed Comparisons
fff00b13 // 68: addi x22, x0, -1    (x22 = 0xFFFFFFFF = -1)
000b2bb3 // 6C: slt  x23, x22, x0   (x22=-1, x0=0 -> -1 < 0 = 1, x23 = 1)
01602c33 // 70: slt  x24, x0, x22   (x0=0, x22=-1 -> 0 < -1 = 0, x24 = 0)
000b2f93 // 74: slti x31, x22, 0    (x22=-1, -1 < 0 = 1, x31 = 1)

// Phase 12: SW/LW at Different Address & Load-Use Forwarding
00302223 // 78: sw   x3, 4(x0)       (Store x3=15 to mem[4])
00402c83 // 7C: lw   x25, 4(x0)     (Load mem[4] -> x25 = 15, triggers Load-Use Stall)
000c8d33 // 80: add  x26, x25, x0   (x26 = x25 + 0 = 15, tests LW->ADD stall/fwd)

// Phase 13: OR/AND with Full-Width Operands
001b6db3 // 84: or   x27, x22, x1   (x22=0xFFFFFFFF | x1=5 = 0xFFFFFFFF, x27 = -1)
001b7e33 // 88: and  x28, x22, x1   (x22=0xFFFFFFFF & x1=5 = 5, x28 = 5)

// Phase 14: LUI with Large Upper Immediate
abcdeeb7 // 8C: lui  x29, 0xABCDE   (x29 = 0xABCDE000)

// Phase 15: SUB with Additional Values
40118f33 // 90: sub  x30, x3, x1    (x3=15, x1=5, x30 = 10)

// End Program (Infinite Loop)
00000063 // 94: beq  x0, x0, 0      (Jump to self)